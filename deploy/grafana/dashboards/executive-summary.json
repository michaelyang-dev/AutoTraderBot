        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 100000 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{
        "refId": "A",
        "type": "json",
        "url": "http://localhost:3001/api/grafana/portfolio",
        "parser": "backend",
        "source": "url",
        "columns": [{ "selector": "portfolio_value", "text": "Portfolio Value", "type": "number" }]
      }]
