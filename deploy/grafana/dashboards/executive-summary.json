    {
      "id": 1,
      "title": "Portfolio Value",
      "description": "Total equity (positions + cash)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "P2E0F8B2B3F5F786E" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/portfolio", "parser": "backend", "source": "url", "columns": [{ "selector": "portfolio_value", "text": "Portfolio Value", "type": "number" }] }]
    },
