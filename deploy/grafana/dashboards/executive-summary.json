      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [{ "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/portfolio", "parser": "backend", "source": "url", "columns": [{ "selector": "win_rate", "text": "Win Rate", "type": "number" }] }]
