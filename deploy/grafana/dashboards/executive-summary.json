    {
      "id": 7,
      "title": "Regime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 17, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "P2E0F8B2B3F5F786E" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "BULLISH": { "text": "BULLISH", "color": "green" }, "CAUTIOUS": { "text": "CAUTIOUS", "color": "yellow" }, "BEARISH": { "text": "BEARISH", "color": "red" }, "UNKNOWN": { "text": "CLOSED", "color": "semi-dark-blue" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "/.*/" }, "colorMode": "background_solid", "graphMode": "none" },
