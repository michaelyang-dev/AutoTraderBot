{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "System Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "ML Server Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "ok": { "text": "ONLINE", "color": "green" }, "offline": { "text": "OFFLINE", "color": "red" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/ml-health", "parser": "backend", "source": "url",
        "columns": [{ "selector": "status", "text": "Status", "type": "string" }]
      }]
    },
    {
      "id": 3,
      "title": "Cached Signals",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 100 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/ml-health", "parser": "backend", "source": "url",
        "columns": [{ "selector": "cached_signals", "text": "Signals", "type": "number" }]
      }]
    },
    {
      "id": 4,
      "title": "Model Version",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/ml-health", "parser": "backend", "source": "url",
        "columns": [{ "selector": "model_version", "text": "Version", "type": "string" }]
      }]
    },
    {
      "id": 5,
      "title": "Feature Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/ml-health", "parser": "backend", "source": "url",
        "columns": [{ "selector": "feature_count", "text": "Features", "type": "number" }]
      }]
    },
    {
      "id": 6,
      "title": "Signal Freshness",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "true": { "text": "STALE", "color": "red" }, "false": { "text": "FRESH", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/ml-health", "parser": "backend", "source": "url",
        "columns": [{ "selector": "is_stale", "text": "Stale", "type": "string" }]
      }]
    },
    {
      "id": 7,
      "title": "Market Breadth",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 50 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/ml-health", "parser": "backend", "source": "url",
        "columns": [{ "selector": "breadth", "text": "Breadth", "type": "number" }]
      }]
    },
    {
      "id": 10,
      "title": "Risk Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Drawdown from Peak (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity", "showPoints": "never", "spanNulls": true },
          "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "max": 0
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/equity", "parser": "backend", "source": "url",
        "columns": [
          { "selector": "date", "text": "Time", "type": "timestamp" },
          { "selector": "drawdown_pct", "text": "Drawdown %", "type": "number" }
        ]
      }]
    },
    {
      "id": 12,
      "title": "Daily P&L Distribution",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "xTickLabelRotation": -45, "barWidth": 0.8, "legend": { "displayMode": "hidden" } },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/equity?since=2024-01-01", "parser": "backend", "source": "url",
        "columns": [
          { "selector": "date", "text": "Date", "type": "string" },
          { "selector": "day_pnl", "text": "Daily P&L", "type": "number" }
        ]
      }]
    },
    {
      "id": 20,
      "title": "Execution Quality",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Slippage Over Time (bps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "pointSize": 4, "spanNulls": true },
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "displayName": "Avg Slippage (bps)"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/slippage", "parser": "backend", "source": "url",
        "columns": [
          { "selector": "date", "text": "Time", "type": "timestamp" },
          { "selector": "avg_slippage_bps", "text": "Avg Slippage (bps)", "type": "number" }
        ]
      }]
    },
    {
      "id": 22,
      "title": "Exit Reason Breakdown",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "total_pnl" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] } }, { "id": "color", "value": { "mode": "thresholds" } }] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/exit-reasons", "parser": "backend", "source": "url",
        "columns": [
          { "selector": "exit_reason", "text": "Exit Reason", "type": "string" },
          { "selector": "count", "text": "Count", "type": "number" },
          { "selector": "total_pnl", "text": "Total P&L", "type": "number" },
          { "selector": "avg_return_pct", "text": "Avg Return %", "type": "number" },
          { "selector": "avg_hold_days", "text": "Avg Hold Days", "type": "number" }
        ]
      }]
    },
    {
      "id": 30,
      "title": "System Events",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Top P&L Symbols",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "xTickLabelRotation": -45, "barWidth": 0.7, "legend": { "displayMode": "hidden" } },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/symbol-distribution", "parser": "backend", "source": "url",
        "columns": [
          { "selector": "symbol", "text": "Symbol", "type": "string" },
          { "selector": "total_pnl", "text": "Total P&L", "type": "number" }
        ]
      }]
    },
    {
      "id": 32,
      "title": "Recent System Events",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_AUTOTRADER_API}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "severity" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "info": { "color": "blue" }, "warning": { "color": "yellow" }, "error": { "color": "red" }, "critical": { "color": "dark-red" } } }] }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "created_at", "desc": true }], "cellHeight": "sm" },
      "targets": [{
        "refId": "A", "type": "json", "url": "http://localhost:3001/api/grafana/events?limit=50", "parser": "backend", "source": "url",
        "columns": [
          { "selector": "created_at", "text": "Time", "type": "timestamp" },
          { "selector": "event_type", "text": "Event Type", "type": "string" },
          { "selector": "severity", "text": "Severity", "type": "string" },
          { "selector": "message", "text": "Message", "type": "string" },
          { "selector": "portfolio_value_at_event", "text": "Portfolio Value", "type": "number" }
        ]
      }]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["autotrader", "risk", "health"],
  "time": { "from": "now-90d", "to": "now" },
  "timezone": "America/New_York",
  "title": "AutoTrader - Risk & System Health",
  "uid": "autotrader-risk",
  "version": 1
}
